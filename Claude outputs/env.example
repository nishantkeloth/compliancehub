# Copy this file to .env and fill in real values. .env is gitignored —
# your credentials never leave your machine and are never seen by Claude.

# Base URL of the app. Defaults to production if omitted.
BASE_URL=https://comphub.aifexis.com

# A real ComplianceHub login for the account you want to test with.
# For the full suite, use an account with crew.manage (Company Admin covers it).
CH_EMAIL=you@example.com
CH_PASSWORD=your-password
